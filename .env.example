# Gitea Radar Environment Variables

# The base URL of the Gitea instance to crawl (default: https://gitea.com)
GITEA_API_URL=https://gitea.com

# Optional Personal Access Token for Gitea API (increases rate limits)
# If left unset, the public anonymous API is used with backoff handling
GITEA_TOKEN=

# Concurrency limit for background releases and metadata fetching
CRAWLER_CONCURRENCY=3

# Delay in milliseconds between consecutive API page requests to be respectful
CRAWLER_PAGE_DELAY_MS=200

# Base URL for production deployment (used for canonical URLs and sitemap generation)
NEXT_PUBLIC_APP_URL=https://gitea-radar.vercel.app
